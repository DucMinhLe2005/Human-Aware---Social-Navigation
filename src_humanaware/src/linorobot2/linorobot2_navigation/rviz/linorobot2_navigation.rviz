            Auto Size Factor: 1
            Value: true
          Class: rviz_default_plugins/DepthCloud
          Color: 255; 255; 255
          Color Image Topic: ""
          Color Transformer: AxisColor
          Axis: Z
          Decay Time: 0
          Depth Map Topic: /camera/depth/image_rect_raw
          Depth Map Transport Hint: raw
          Enabled: false  # tat 2026-09-16 theo yeu cau: khong can dam may do sau tren ban do nua
          Invert Rainbow: false
          Name: Camera Depth
          Occlusion Compensation:
            Occlusion Time-Out: 30
            Value: false
          Position Transformer: XYZ
          Queue Size: 5
          Selectable: false
          Size (Pixels): 2
          Style: Points
          Topic Filter: true
          Use rainbow: true
          Value: true
        - Class: rviz_default_plugins/CameraInfo
          Alpha: 0.2
          Color: 0; 170; 255
          Edge color: 0; 120; 255
          # tat 2026-09-16: chi ve hinh non goc nhin, khong can khi lai xe.
          # Bat lai khi muon kiem camera dang huong ve dau.
          Enabled: false
          Far clip: 5
          Name: Camera FOV
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /camera/color/camera_info
          Value: true
        # DA THU VA DA GO -- 2026-09-16. Da them mot display
        # rviz_default_plugins/Image (/camera/color/image_raw) vao day de xem anh
        # mau ngay trong RViz. Ket qua: rviz2 segfault 4 lan trong 25 phut
        # (18:41:55, 18:43:15, 18:45:34, 19:04:56), tat ca trong libQt5Gui/
        # libQt5Core -- dung tang Qt ma ghi chu cu da mo ta (QWindow::requestUpdate
        # <- rviz_rendering::RenderWindow::exposeEvent). Truoc khi them thi rviz
        # chay binh thuong.
        #
        # KET LUAN: KHONG dat display Image vao file nay. Muon xem anh camera thi
        # mo cua so rieng, khong crash va cung khong an CPU cua NUC:
        #     ros2 run rqt_image_view rqt_image_view /camera/color/image_raw
      Enabled: true
      Name: Realsense
