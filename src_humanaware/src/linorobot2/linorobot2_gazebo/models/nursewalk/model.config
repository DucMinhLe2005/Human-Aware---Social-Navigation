<?xml version="1.0"?>
<model>
  <name>nursewalk</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    Walking nurse actor with skeleton and texture, from Fuel (Luca/NurseFemaleWalk).
    Used instead of the untextured grey mannequin of mingfei/actor, which the
    person detector rarely recognises. The model origin is at the FEET
    (z 0..1.61 m), so trajectory waypoints use z = 0.0.
  </description>
</model>
