<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>social_nav_tracking_cpp</name>
  <version>0.0.0</version>
  <description>C++ human tracker (Hungarian assignment + Kalman filter + lidar/camera fusion). Shares its parameters with social_nav_tracking; select the implementation with the tracker_impl launch argument.</description>
  <maintainer email="bhung1175@gmail.com">hung</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>thesis_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>eigen</depend>

  <!-- Parameter file shared with the Python implementation
       (share/social_nav_tracking/config/human_tracker_params.yaml). -->
  <exec_depend>social_nav_tracking</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
