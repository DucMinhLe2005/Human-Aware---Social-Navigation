<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>social_nav_safety_cpp</name>
  <version>0.0.0</version>
  <description>C++ lidar safety layer: last guard between the planner and the motor driver. Shares its parameters with social_nav_safety; select the implementation with the safety_impl launch argument.</description>
  <maintainer email="bhung1175@gmail.com">hung</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Parameter file shared with the Python implementation
       (share/social_nav_safety/config/lidar_safety_params.yaml). -->
  <exec_depend>social_nav_safety</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
